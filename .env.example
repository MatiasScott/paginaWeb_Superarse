# =============================================================================
# Configuración del sitio — Instituto Superarse
# =============================================================================
# CÓMO USARLO
#   1. Copia este archivo como ".env" en la raíz del proyecto.
#   2. En producción, edita SOLO la línea APP_URL de abajo.
#   3. Listo. No hace falta tocar ni una sola ruta en el código.
#
#        cp .env.example .env
#
# El archivo .env está en .gitignore: nunca se sube al repositorio.
#
# Las variables que el servidor ya tenga definidas (panel del hosting, php.ini,
# variables de entorno del contenedor) TIENEN PRIORIDAD sobre este archivo.
# =============================================================================


# -----------------------------------------------------------------------------
# URL DE PRODUCCIÓN  ←  LO ÚNICO QUE NECESITAS CAMBIAR
# -----------------------------------------------------------------------------
# Incluye el subdirectorio si la web NO vive en la raíz del dominio.
#
#   En la raíz del dominio   ->  APP_URL=https://superarse.edu.ec
#   En una subcarpeta        ->  APP_URL=https://superarse.edu.ec/PaginaWebMVC
#
# Déjalo en "auto" si prefieres que el proyecto detecte la ruta solo
# (compara la carpeta del proyecto contra DOCUMENT_ROOT del servidor).
APP_URL=auto

# Fuerza el prefijo de rutas sin tocar APP_URL. Solo si usas un proxy o un
# document root distinto al de la carpeta real del proyecto. Ej: /PaginaWebMVC
APP_BASE_PATH=auto


# -----------------------------------------------------------------------------
# ENTORNO
# -----------------------------------------------------------------------------
# local | production
APP_ENV=local

# Muestra errores de PHP en pantalla. Déjalo en false en producción.
APP_DEBUG=true

# Nombre del sitio (se inyecta en el objeto window.APP de JavaScript)
APP_NAME=Instituto Superarse


# -----------------------------------------------------------------------------
# BASE DE DATOS — Analítica (api/analytics/db.php)
# -----------------------------------------------------------------------------
# Estas credenciales estaban fijas en el código y quedaron registradas en el
# repositorio: rótalas en el servidor apenas puedas.
SUPERARSE_DB_HOST=127.0.0.1
SUPERARSE_DB_PORT=3306
SUPERARSE_DB_NAME=superarse_db
SUPERARSE_DB_USER=root
SUPERARSE_DB_PASS=cambia-esta-clave

# Zona horaria de Ecuador (UTC-5, sin horario de verano)
APP_TIMEZONE=America/Guayaquil
SUPERARSE_MYSQL_TZ=-05:00


# -----------------------------------------------------------------------------
# CORREO (PHPMailer) — Office 365
# -----------------------------------------------------------------------------
# Son DOS cuentas distintas, con usuario y contraseña propios. La clave de
# aplicación de Office 365 también quedó en el repositorio: rótala.
SUPERARSE_SMTP_HOST=smtp.office365.com

# ── Cuenta institucional ──────────────────────────────────────────────────
# Buzón web (app/Models/Buzon/BuzonModel.php)
# Formulario de bienestar (app/Controllers/Services/FormularioBienestarController.php)
SUPERARSE_SMTP_USERNAME=informacion@superarse.edu.ec
SUPERARSE_SMTP_PASSWORD=cambia-esta-clave
SUPERARSE_SMTP_FROM=informacion@superarse.edu.ec

# ── Cuenta secundaria ─────────────────────────────────────────────────────
# Solicitudes (app/Controllers/Services/SolicitudesController.php)
# Formulario de admisión (app/Models/Contacto/ContactoModel.php)
# Firma de contrato (app/Controllers/Admisiones/FirmaContratoController.php)
SUPERARSE_SMTP_ALT_USERNAME=cuenta-secundaria@superarse.edu.ec
SUPERARSE_SMTP_ALT_PASSWORD=cambia-esta-clave
SUPERARSE_SMTP_ALT_FROM=cuenta-secundaria@superarse.edu.ec


# -----------------------------------------------------------------------------
# PANEL DE ANALÍTICA (tics-analytics-sec.php)
# -----------------------------------------------------------------------------
# Clave de acceso al dashboard. La anterior está publicada en git: cámbiala.
TICS_ACCESS_KEY=cambia-esta-clave
TICS_SESSION_TIMEOUT=1800
